# Spur backend the MCP server calls (no /api suffix)
SPUR_API_URL=http://localhost:3001

# Public URL of this server; the MCP endpoint is $MCP_PUBLIC_URL/mcp and it is also the OAuth issuer
MCP_PUBLIC_URL=http://localhost:8787
PORT=8787
# Bind address; use 0.0.0.0 in containers (defaults to 0.0.0.0 on Vercel)
HOST=127.0.0.1
# Extra Host header values to accept (comma-separated), e.g. behind a proxy
MCP_ALLOWED_HOSTS=

# 32+ random characters; seals OAuth codes/tokens and postcard confirmations. Same value on every instance.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN_SECRET=

# Optional: enables "Continue with Google" on the sign-in page. Same Supabase project as the web app
# (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY). Add $MCP_PUBLIC_URL/oauth/google/callback to Supabase's Redirect URLs.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Spur web app URL, used for "open in Spur" links in widgets and fetch results
SPUR_APP_URL=http://localhost:5173

# Map tiles for the property explorer. Over HTTP the widget loads tiles through this server's caching
# proxy (/tiles/{z}/{x}/{y}.png), which identifies itself, caches and rate-limits as the OpenStreetMap
# tile policy requires. Change MAP_TILE_URL to switch providers; any API key in it stays server-side.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Must credit OpenStreetMap visibly (default links to openstreetmap.org/copyright)
MAP_TILE_ATTRIBUTION=
# Contact email or URL sent in the proxy's User-Agent so the tile operator can reach you. Set in production.
MAP_TILE_CONTACT=
# In-memory tile cache size, upstream fetch concurrency, and tile requests per client IP per 5 minutes
MAP_TILE_CACHE_MB=256
MAP_TILE_UPSTREAM_CONCURRENCY=4
MAP_TILE_CLIENT_LIMIT=1500

# Extra https origins widgets may load images from (comma-separated), e.g. your Supabase storage for postcard art
WIDGET_IMAGE_DOMAINS=

# stdio mode only (TRANSPORT=stdio): a single local user's Spur session
SPUR_ACCESS_TOKEN=
SPUR_REFRESH_TOKEN=
